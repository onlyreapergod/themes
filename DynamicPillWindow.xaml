<Window x:Class="Win11ProSuite.DynamicPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11ProSuite Media Island"
        Width="460"
        Height="124"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <!-- The pill is the only visible element; transparent window pixels stay click-through. -->
        <Border x:Name="Pill"
                Width="250"
                Height="40"
                CornerRadius="22"
                Background="#F0111114"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,4,0,0"
                MouseEnter="Pill_MouseEnter"
                MouseLeave="Pill_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" />
            </Border.Effect>

            <Grid Margin="8,4,8,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Always-visible row: cover + title/artist -->
                <Grid Grid.Row="0" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CoverBorder" Width="30" Height="30" CornerRadius="15" Background="#2A2A32">
                        <TextBlock x:Name="CoverGlyph" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#9A9AA6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="12" FontWeight="SemiBold"
                                   Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistText" Text="Start music in Spotify or Chrome" FontSize="10.5"
                                   Foreground="#A0A0AA" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Revealed on hover: transport controls + live CPU / RAM -->
                <Grid x:Name="ControlsPanel" Grid.Row="1" Margin="0,8,0,0" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CpuText" Text="CPU 0%" FontSize="11" Foreground="#8E8E99"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                                Click="Previous_Click" ToolTip="Previous" />
                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                Background="#26FFFFFF" Margin="6,0" Click="PlayPause_Click" ToolTip="Play / Pause" />
                        <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                                Click="Next_Click" ToolTip="Next" />
                    </StackPanel>

                    <TextBlock x:Name="RamText" Grid.Column="2" Text="RAM 0%" FontSize="11" Foreground="#8E8E99"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
